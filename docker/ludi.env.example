# Store the real file at /opt/ludi/.env with mode 600; never commit it.
LUDI_IMAGE=ludi:RELEASE_COMMIT
LUDI_DOMAIN=ludi.usepdc.com
LUDI_PROXY_NETWORK=pdc-prod_pdc-network
# Obtain the actual peer, refresh after Traefik is recreated:
# docker inspect pdc-traefik --format '{{(index .NetworkSettings.Networks "pdc-prod_pdc-network").IPAddress}}'
LUDI_TRUSTED_PROXY_IP=SET_FROM_DOCKER_INSPECT
# Generate with: openssl rand -hex 32
SESSION_PASSWORD=REPLACE_WITH_RANDOM_SECRET
